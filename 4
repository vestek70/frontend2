<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Konstantin Borisov | Full-Stack Developer</title>
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;700&family=Inter:wght@400;700&display=swap" rel="stylesheet">
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { background-color: #000; color: #fff; font-family: 'Inter', sans-serif; overflow-x: hidden; }
        
        canvas {
            position: fixed; top: 0; left: 0;
            width: 100%; height: 100%;
            z-index: 1; /* Фон */
            display: block;
        }

        /* Контент поверх звезд */
        .content-layer {
            position: relative;
            z-index: 10;
            pointer-events: none;
        }

        nav {
            position: fixed; top: 0; width: 100%; padding: 30px 10%;
            display: flex; justify-content: space-between; align-items: center;
            z-index: 100; pointer-events: auto;
        }
        .logo { font-family: 'Space Grotesk'; font-size: 1.5rem; color: #00f2ff; font-weight: 700; text-decoration: none; }
        .nav-links { display: flex; list-style: none; gap: 30px; }
        .nav-links a { color: #fff; text-decoration: none; font-size: 0.9rem; text-transform: uppercase; letter-spacing: 1px; }

        section { min-height: 100vh; padding: 100px 10%; display: flex; flex-direction: column; justify-content: center; }
        
        h1 { font-family: 'Space Grotesk'; font-size: clamp(3rem, 10vw, 6rem); line-height: 1; margin-bottom: 20px; }
        .accent { color: #00f2ff; }

        .glass-box {
            background: rgba(255, 255, 255, 0.05);
            backdrop-filter: blur(15px);
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 20px;
            padding: 50px;
            max-width: 800px;
            pointer-events: auto;
        }

        .project-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 20px; margin-top: 40px; }
        .project-card { 
            padding: 30px; background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.1); 
            border-radius: 15px; pointer-events: auto; transition: 0.3s;
        }
        .project-card:hover { border-color: #00f2ff; transform: translateY(-5px); }

        .contact-mail { color: #00f2ff; font-size: 1.8rem; font-weight: 700; text-decoration: none; pointer-events: auto; }
        
        footer { padding: 50px 10%; text-align: center; opacity: 0.5; font-size: 0.8rem; }
    </style>
</head>
<body>

    <canvas id="star-canvas"></canvas>

    <div class="content-layer">
        <nav>
            <a href="#" class="logo">Konstantin Borisov</a>
            <ul class="nav-links">
                <li><a href="#hero">Начало</a></li>
                <li><a href="#about">Обо мне</a></li>
                <li><a href="#contact">Контакт</a></li>
            </ul>
        </nav>

        <section id="hero">
            <h1>Developer <br><span class="accent">Full-stack</span></h1>
            <p style="font-size: 1.2rem; max-width: 500px; opacity: 0.8;">Full-stack разработчик. Создаю системы, где визуальная эстетика встречается с безупречным кодом.</p>
        </section>

        <section id="about">
            <div class="glass-box">
                <h2 style="font-family: 'Space Grotesk'; margin-bottom: 20px; font-size: 2.5rem;">Обо мне</h2>
                <p style="line-height: 1.6; opacity: 0.8;">
                    Я Константин Борисов. Моя специализация — высоконагруженные интерфейсы и интерактивная 3D-графика. 
                    В этом окружении работает 35 000 круглых звезд, каждая из которых имеет свой вектор инерции, но всегда возвращается на свою позицию.
                </p>
                <div class="project-grid">
                    <div class="project-card"><h3>Проекты</h3><p>Разработка WebGL движков и сложных UI систем.</p></div>
                    <div class="project-card"><h3>Стек</h3><p>Three.js, React, Node.js, GSAP.</p></div>
                </div>
            </div>
        </section>

        <section id="contact">
            <h2 style="font-family: 'Space Grotesk'; margin-bottom: 20px;">Связь</h2>
            <p style="margin-bottom: 20px; opacity: 0.8;">Готов к новым вызовам и интересным проектам.</p>
            <a href="mailto:vestek70@gmail.com" class="contact-mail">vestek70@gmail.com</a>
        </section>

        <footer>
            &copy; 2026 Konstantin Borisov. Все права защищены.
        </footer>
    </div>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>

    <script>
        window.addEventListener('load', () => {
            const canvas = document.querySelector('#star-canvas');
            const renderer = new THREE.WebGLRenderer({ canvas, antialias: true, alpha: true });
            renderer.setSize(window.innerWidth, window.innerHeight);
            renderer.setPixelRatio(window.devicePixelRatio);

            const scene = new THREE.Scene();
            const camera = new THREE.PerspectiveCamera(75, window.innerWidth / window.innerHeight, 0.1, 1000);
            camera.position.z = 50;

            // 1. Улучшенная ТЕКСТУРА КРУГЛОЙ ЗВЕЗДЫ (Яркая и четкая)
            function createStarTexture() {
                const c = document.createElement('canvas');
                c.width = 64; c.height = 64;
                const ctx = c.getContext('2d');
                const g = ctx.createRadialGradient(32, 32, 0, 32, 32, 32);
                g.addColorStop(0, 'rgba(255, 255, 255, 1)'); // Чисто белый центр
                g.addColorStop(0.2, 'rgba(180, 245, 255, 0.9)'); // Голубоватое свечение
                g.addColorStop(0.5, 'rgba(0, 242, 255, 0.2)'); // Мягкий ореол
                g.addColorStop(1, 'rgba(0, 0, 0, 0)');
                ctx.fillStyle = g;
                ctx.fillRect(0, 0, 64, 64);
                return new THREE.CanvasTexture(c);
            }
            const starTexture = createStarTexture();

            // 2. ЗВЕЗДНОЕ ПОЛЕ (35 000 звезд)
            const count = 35000;
            const geo = new THREE.BufferGeometry();
            const pos = new Float32Array(count * 3);
            const anchors = new Float32Array(count * 3); // Точки возврата

            for(let i = 0; i < count * 3; i++) {
                const val = (Math.random() - 0.5) * 180;
                pos[i] = anchors[i] = val;
            }

            geo.setAttribute('position', new THREE.BufferAttribute(pos, 3));
            const material = new THREE.PointsMaterial({
                size: 0.6, // Размер увеличен для видимости
                map: starTexture,
                transparent: true,
                blending: THREE.AdditiveBlending,
                depthWrite: false
            });

            const starField = new THREE.Points(geo, material);
            scene.add(starField);

            // 3. КОМЕТЫ
            const comets = [];
            for(let i = 0; i < 2; i++) {
                const head = new THREE.Mesh(new THREE.SphereGeometry(0.15, 8, 8), new THREE.MeshBasicMaterial({color: 0xffffff}));
                const tailLen = 40;
                const tailGeo = new THREE.BufferGeometry();
                const tailArr = new Float32Array(tailLen * 3);
                tailGeo.setAttribute('position', new THREE.BufferAttribute(tailArr, 3));
                const tailLine = new THREE.Line(tailGeo, new THREE.LineBasicMaterial({color: 0x00f2ff, transparent: true, opacity: 0.5}));
                scene.add(head, tailLine);
                comets.push({ head, line: tailLine, arr: tailArr, angle: Math.random()*6, rad: 20+i*15, speed: 0.005, yA: (Math.random()-0.5)*30 });
            }

            // 4. МЫШЬ И ИНЕРЦИЯ
            let m = { x: 0, y: 0 }, t = { x: 0, y: 0 };
            window.addEventListener('mousemove', (e) => {
                t.x = (e.clientX / window.innerWidth - 0.5) * 70;
                t.y = -(e.clientY / window.innerHeight - 0.5) * 70;
            });

            // 5. АНИМАЦИЯ
            function animate() {
                requestAnimationFrame(animate);
                m.x += (t.x - m.x) * 0.02;
                m.y += (t.y - m.y) * 0.02;

                const p = geo.attributes.position.array;
                for(let i = 0; i < count; i++) {
                    const i3 = i * 3;
                    // Пружинный возврат к якорю
                    p[i3] += (anchors[i3] - p[i3]) * 0.04;
                    p[i3+1] += (anchors[i3+1] - p[i3+1]) * 0.04;

                    // Реакция на мышь
                    const dx = m.x - p[i3];
                    const dy = m.y - p[i3+1];
                    const dist = Math.sqrt(dx*dx + dy*dy);
                    if(dist < 35) {
                        const f = (35 - dist) * 0.025;
                        p[i3] -= dx * f;
                        p[i3+1] -= dy * f;
                    }
                }
                geo.attributes.position.needsUpdate = true;

                comets.forEach(c => {
                    c.angle += c.speed;
                    c.head.position.set(Math.cos(c.angle)*c.rad, Math.sin(c.angle*0.5)*c.yA, Math.sin(c.angle)*c.rad);
                    const a = c.arr;
                    for(let i = 39; i > 0; i--) { a[i*3]=a[(i-1)*3]; a[i*3+1]=a[(i-1)*3+1]; a[i*3+2]=a[(i-1)*3+2]; }
                    a[0]=c.head.position.x; a[1]=c.head.position.y; a[2]=c.head.position.z;
                    c.line.geometry.attributes.position.needsUpdate = true;
                });

                renderer.render(scene, camera);
            }
            animate();

            window.addEventListener('resize', () => {
                camera.aspect = window.innerWidth / window.innerHeight;
                camera.updateProjectionMatrix();
                renderer.setSize(window.innerWidth, window.innerHeight);
            });
        });
    </script>
</body>
</html>
